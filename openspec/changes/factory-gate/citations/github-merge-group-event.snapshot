:"text","value":"POSIX cron syntax"}]},{"type":"text","value":" to schedule workflows to run at specific times. By default, scheduled workflows run in UTC. You can optionally specify a timezone using an "},{"type":"element","tagName":"a","properties":{"href":"https://en.wikipedia.org/wiki/List_of_tz_database_time_zones"},"children":[{"type":"text","value":"IANA timezone string"}]},{"type":"text","value":" for timezone-aware scheduling. Scheduled workflows run on the latest commit on the default branch. The shortest interval you can run scheduled workflows is once every 5 minutes."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nFor schedules that set "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"timezone"}]},{"type":"text","value":" to a time zone that observes daylight saving time (DST), during DST spring-forward transitions, scheduled workflows in skipped hours advance to the next valid time. For example, a 2:30 AM schedule advances to 3:00 AM."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Cron syntax has five fields separated by a space, and each field represents a unit of time."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"pre","properties":{},"children":[{"type":"element","tagName":"code","properties":{"className":["hljs","language-text"]},"children":[{"type":"text","value":"┌───────────── minute (0 - 59)\n│ ┌───────────── hour (0 - 23)\n│ │ ┌───────────── day of the month (1 - 31)\n│ │ │ ┌───────────── month (1 - 12 or JAN-DEC)\n│ │ │ │ ┌───────────── day of the week (0 - 6 or SUN-SAT)\n│ │ │ │ │\n* * * * *\n"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can use these operators in any of the five fields:"}]},{"type":"text","value":"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"},{"type":"element","tagName":"table","properties":{},"children":[{"type":"element","tagName":"thead","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"Operator"}]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"Description"}]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"Example"}]}]}]},{"type":"element","tagName":"tbody","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"*"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Any value"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"15 * * * *"}]},{"type":"text","value":" runs at every minute 15 of every hour of every day."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":","}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Value list separator"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"2,10 4,5 * * *"}]},{"type":"text","value":" runs at minute 2 and 10 of the 4th and 5th hour of every day."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"-"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Range of values"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"30 4-6 * * *"}]},{"type":"text","value":" runs at minute 30 of the 4th, 5th, and 6th hour."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"/"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Step values"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"20/15 * * * *"}]},{"type":"text","value":" runs every 15 minutes starting from minute 20 through 59 (minutes 20, 35, and 50)."}]}]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"This example triggers the workflow to run at 5:30 AM in the America/New_York timezone every Monday through Friday:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"pre","properties":{},"children":[{"type":"element","tagName":"code","properties":{"className":["hljs","language-yaml"]},"children":[{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"on:"}]},{"type":"text","value":"\n  "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"schedule:"}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["hljs-bullet"]},"children":[{"type":"text","value":"-"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"cron:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"'30 5 * * 1-5'"}]},{"type":"text","value":"\n      "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"timezone:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"\"America/New_York\""}]},{"type":"text","value":"\n"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"A single workflow can be triggered by multiple "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"schedule"}]},{"type":"text","value":" events. Access the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"schedule"}]},{"type":"text","value":" event that triggered the workflow through the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"github.event.schedule"}]},{"type":"text","value":" context. This example triggers the workflow to run at 5:30 UTC every Monday-Thursday, and 17:30 UTC on Tuesdays and Thursdays, but skips the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"Not on Monday or Wednesday"}]},{"type":"text","value":" step on Monday and Wednesday."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"pre","properties":{},"children":[{"type":"element","tagName":"code","properties":{"className":["hljs","language-yaml"]},"children":[{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"on:"}]},{"type":"text","value":"\n  "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"schedule:"}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["hljs-bullet"]},"children":[{"type":"text","value":"-"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"cron:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"'30 5 * * 1,3'"}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["hljs-bullet"]},"children":[{"type":"text","value":"-"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"cron:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"'30 5,17 * * 2,4'"}]},{"type":"text","value":"\n\n"},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"jobs:"}]},{"type":"text","value":"\n  "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"test_schedule:"}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"runs-on:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"ubuntu-latest"}]},{"type":"text","value":"\n    "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"steps:"}]},{"type":"text","value":"\n      "},{"type":"element","tagName":"span","properties":{"className":["hljs-bullet"]},"children":[{"type":"text","value":"-"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"name:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"Not"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"on"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"Monday"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"or"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"Wednesday"}]},{"type":"text","value":"\n        "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"if:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"github.event.schedule"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-type"]},"children":[{"type":"text","value":"!="}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"'30 5 * * 1,3'"}]},{"type":"text","value":"\n        "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"run:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"echo"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"\"This step will be skipped on Monday and Wednesday\""}]},{"type":"text","value":"\n      "},{"type":"element","tagName":"span","properties":{"className":["hljs-bullet"]},"children":[{"type":"text","value":"-"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"name:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"Every"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"time"}]},{"type":"text","value":"\n        "},{"type":"element","tagName":"span","properties":{"className":["hljs-attr"]},"children":[{"type":"text","value":"run:"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"echo"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"\"This step will always run\""}]},{"type":"text","value":"\n"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nGitHub Actions does not support the non-standard syntax "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"@yearly"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"@monthly"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"@weekly"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"@daily"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"@hourly"}]},{"type":"text","value":", and "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"@reboot"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can use "},{"type":"element","tagName":"a","properties":{"href":"https://crontab.guru/"},"children":[{"type":"text","value":"crontab guru"}]},{"type":"text","value":" to help generate your cron syntax and confirm what time it will run. To help you get started, there is also a list of "},{"type":"element","tagName":"a","properties":{"href":"https://crontab.guru/examples.html"},"children":[{"type":"text","value":"crontab guru examples"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"actor-for-scheduled-workflows","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#actor-for-scheduled-workflows"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" for scheduled workflows"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Certain repository events change the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" associated with the workflow. For example, a user who changes the default branch of the repository, which changes the branch on which scheduled workflows run, becomes "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" for those scheduled workflows."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For a deactivated scheduled workflow, if a user with "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"write"}]},{"type":"text","value":" permissions to the repository makes a commit that changes the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"cron"}]},{"type":"text","value":" schedule on the workflow, the workflow will be reactivated, and that user will become the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" associated with any workflow runs."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Notifications for scheduled workflows are sent to the user who last modified the cron syntax in the workflow file. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/actions/concepts/workflows-and-actions/notifications-for-workflow-runs"},"children":[{"type":"text","value":"Notifications for workflow runs"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nFor an enterprise with Enterprise Managed Users, triggering a scheduled workflow requires that the status of the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" user account associated with the workflow is currently active (i.e. not suspended or deleted)."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Scheduled workflows will not run if the last "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" associated with the scheduled workflow has been deprovisioned by the Enterprise Managed User identity provider (IdP). However, if the last "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" Enterprise Managed User has not been deprovisioned by the IdP, and has only been removed as a member from a given organization in the enterprise, scheduled workflows will still run with that user set as the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Similarly, for an enterprise without Enterprise Managed Users, removing a user from an organization will not prevent scheduled workflows which had that user as their "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"actor"}]},{"type":"text","value":" from running."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Thus, the "},{"type":"element","tagName":"em","properties":{},"children":[{"type":"text","value":"user account's"}]},{"type":"text","value":" status, in both Enterprise Managed User and non-Enterprise Managed User scenarios, is what's important, "},{"type":"element","tagName":"em","properties":{},"children":[{"type":"text","value":"not"}]},{"type":"text","value":" the user's "},{"type":"element","tagName":"em","properties":{},"children":[{"type":"text","value":"membership status"}]},{"type":"text","value":" in the organization where the scheduled workflow is located."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"status","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#status"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"status"}]},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n\n\n\n\n