"type":"text","value":"- "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"auto_merge_disabled"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Last merge commit on the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"GITHUB_REF"}]},{"type":"text","value":" branch"}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"PR merge branch "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"refs/"},{"type":"element","tagName":"wbr","properties":{},"children":[]},{"type":"text","value":"pull/"},{"type":"element","tagName":"wbr","properties":{},"children":[]},{"type":"text","value":"PULL_REQUEST_"},{"type":"element","tagName":"wbr","properties":{},"children":[]},{"type":"text","value":"NUMBER/"},{"type":"element","tagName":"wbr","properties":{},"children":[]},{"type":"text","value":"merge"}]}]}]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":""}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"More than one activity type triggers this event. For information about each activity type, see "},{"type":"element","tagName":"a","properties":{"href":"/en/webhooks/webhook-events-and-payloads#pull_request"},"children":[{"type":"text","value":"Webhook events and payloads"}]},{"type":"text","value":". By default, a workflow only runs when a "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request"}]},{"type":"text","value":" event's activity type is "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"opened"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"synchronize"}]},{"type":"text","value":", or "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"reopened"}]},{"type":"text","value":". To trigger workflows by different activity types, use the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"types"}]},{"type":"text","value":" keyword. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/actions/reference/workflows-and-actions/workflow-syntax#onevent_nametypes"},"children":[{"type":"text","value":"Workflow syntax for GitHub Actions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Workflows will not run on "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request"}]},{"type":"text","value":" activity if the pull request has a merge conflict. The merge conflict must be resolved first. Conversely, workflows with the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request_target"}]},{"type":"text","value":" event will run even if the pull request has a merge conflict. Before using the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request_target"}]},{"type":"text","value":" trigger, you should be aware of the security risks. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"#pull_request_target"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request_target"}]}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"The "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request"}]},{"type":"text","value":" webhook event payload is empty for merged pull requests and pull requests that come from forked repositories."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"When a pull request is created or updated by a workflow using "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"GITHUB_TOKEN"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request"}]},{"type":"text","value":" events with the "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"opened"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"synchronize"}]},{"type":"text","value":", or "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"reopened"}]},{"type":"text","value":" activity types create workflow runs that require approval. A user with write access to the repository can approve these runs from the pull request page. With the exception of "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"workflow_dispatch"}]},{"type":"text","value":" and "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"repository_dispatch"}]},{"type":"text","value":", other "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"GITHUB_TOKEN"}]},{"type":"text","value":"-triggered events do not create workflow runs at all."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"The value of "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"GITHUB_REF"}]},{"type":"text","value":" varies for a closed pull request depending on whether the pull request has been merged or not. If a pull request was closed but not merged, it will be "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"refs/pull/PULL_REQUEST_NUMBER/merge"}]},{"type":"text","value":". If a pull request was closed as a result of being merged, it will be the fully qualified "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"ref"}]},{"type":"text","value":" of the branch it was merged into, for example "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"/refs/heads/main"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Runs your workflow when activity on a pull request in the workflow's repository occurs. For example, if no activity types are specified, the workflow runs when a pull request is opened or reopened or when the head branch of the pull request is updated. For activity related to pull request reviews, pull request review comments, or pull request comments, use the "},{"type":"element","tagName":"a","properties":{"href":"#pull_request_review"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request_review"}]}]},{"type":"text","value":", "},{"type":"element","tagName":"a","properties":{"href":"#pull_request_review_comment"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"pull_request_review_comment"}]}]},{"type":"text","value":", or "},{"type":"element","tagName":"a","properties":{"href":"#issue_comment"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"issue_comment"}]}]},{"type":"text","value":" events instead. For information about the pull request APIs, see "},{"type":"element","tagName":"a","properties":{"href":"/en/graphql/reference/pulls#object-pullrequest"},"children":[{"type":"text","value":"Pull requests"}]},{"type":"text","value":" in the GraphQL API documentation or "},{"type":"element","tagName":"a","properties":{"href":"/en/rest/pulls"},"children":[{"type":"text","value":"REST API endpoints for pull requests"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Note that "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"GITHUB_SHA"}]},{"type":"text","value":" for this event is the last merge commit of the pull request merge branch. If you want to get the commit ID for the last commit to the head branch of the pull request, use "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"github.event.pull_request.head.sha"}]},{"type":"text","value":" instead. For more information about merge branches, see "},{"type":"element","tagName":"a","properties":{"href":"/en/pull-requests/reference/pull-requests#pull-request-refs-and-merge-branches"},"children":[{"type":"text","value":"Pull requests"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"how-the-merge-branch-aff